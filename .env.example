# Copy this file to ".env" (same folder) and fill in the values. Never share or publish .env.

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# a long random secret (20+ characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"); enter the same one in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Website chat ---
# websites allowed to embed the chat widget, comma separated
ALLOWED_ORIGINS=
# Keep 127.0.0.1 (also on a server: Caddy is the only thing that should be reachable from the internet, and the service
# file sets it). 0.0.0.0 would open this port to everyone and skip Caddy's limits and admin block.
HOST=127.0.0.1
PORT=8080

# --- Privacy (GDPR) ---
# link to your privacy policy, shown in the chat (https only)
PRIVACY_URL=
# days to keep records before they are deleted automatically (0 = keep forever)
RETENTION_HANDOFF_DAYS=180
RETENTION_FEEDBACK_DAYS=90
RETENTION_LOGS_DAYS=30
RETENTION_GAPS_DAYS=60
# check with:  python -m rag.privacy status
# Secret key for the keyed hashes that stand in for WhatsApp numbers in sessions/ and gaps/ (see rag/pseudonym.py).
# Empty = a random key is made once in the file .privacy_key. Keep it out of backups of the data folders.
PRIVACY_HASH_KEY=

# --- Admin dashboard (off until you set a strong password) ---
# make one with:  python -m rag.admin setup      then open http://127.0.0.1:8080/admin
ADMIN_PASSWORD=
# only these addresses may open /admin (comma list, networks allowed, e.g. 203.0.113.7,10.0.0.0/8); empty = anyone with the password.
# Set it on a public server. Caddy (deploy/Caddyfile) has the same restriction; this one also protects you if Caddy is bypassed.
ADMIN_ALLOWED_IPS=
# site names /admin may be opened under (comma list). Set it on a server: a web page on another site cannot then reach /admin
# through your browser under a name of its own. Empty = no check.
ALLOWED_HOSTS=
# web addresses in answers: only faiyke.com, your BOOKING_URL and PRIVACY_URL hosts stay clickable; add others here (comma list,
# subdomains included), e.g. a carrier's tracking site. Every other address is replaced by "[link removed]".
LINK_ALLOWED_DOMAINS=
# "off" stops saving unanswered questions (they feed the dashboard)
LOG_GAPS=on

# --- Limits (optional) ---
RATE_LIMIT_PER_MIN=15
DAILY_MESSAGE_CAP=2000
# percent of the daily cap one visitor (IP address or WhatsApp number) may use, so one bot cannot use up the day for everyone
PER_VISITOR_DAILY_SHARE=10
# addresses of reverse proxies in front of this server whose X-Forwarded-For header is believed (Caddy on the same server:
# the default 127.0.0.1,::1 is right). Use "none" if nothing sits in front of the server.
TRUSTED_PROXIES=127.0.0.1,::1
# answers that may be streamed to customers at the same time (more get "busy")
MAX_STREAMS=40

# --- Email for hand-offs (optional; Gmail needs an app password) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
HANDOFF_TO=
# optional: SMTP_PORT=587 (use 465 for implicit TLS), HANDOFF_FROM=
# max hand-offs saved per day, and max hand-off emails per day (stops inbox flooding)
HANDOFF_DAILY_CAP=200
HANDOFF_EMAIL_DAILY_CAP=30
# check it with:  python -m rag.handoff status   then   python -m rag.handoff test
